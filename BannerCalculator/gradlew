#!/bin/sh
# Gradle wrapper script

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")
DIRNAME=$(dirname "$0")
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

die() { echo "$*" >&2; exit 1; }

CLASSPATH=$DIRNAME/gradle/wrapper/gradle-wrapper.jar

JAVACMD="${JAVA_HOME:+$JAVA_HOME/bin/}java"
command -v "$JAVACMD" >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
